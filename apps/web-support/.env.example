# [VITE_APP_URL] URL ứng dụng Creator, dùng cho nút quay lại ứng dụng, đăng nhập và liên kết tài liệu.
# [VITE_APP_URL] Local dùng http://localhost:5173; khi deploy đổi sang domain client thật. Biến VITE_ công khai và cần rebuild khi đổi.
VITE_APP_URL=http://localhost:5173

# [VITE_DEVELOPER_URL] URL đầy đủ trang Developer, dùng cho hướng dẫn tích hợp API.
# [VITE_DEVELOPER_URL] Để trống sẽ dùng /developer trên VITE_APP_URL.
VITE_DEVELOPER_URL=http://localhost:5173/developer

# [VITE_SUPPORT_CONTACT_URL] Kênh tiếp nhận hỗ trợ thật (URL https hoặc mailto), chỉ điền khi kênh đã hoạt động.
# [VITE_SUPPORT_CONTACT_URL] Để trống sẽ ẩn nút liên hệ. Không dùng email minh họa hoặc đường dẫn chưa hoạt động.
VITE_SUPPORT_CONTACT_URL=
# [VITE_API_URL] URL gốc backend API, chat gửi đến /support/chat từ URL này. Không phải URL dịch vụ Gemma.
# [VITE_API_URL] Local dùng http://localhost:3001/api; có thể dùng /api khi proxy đã cấu hình. Production đặt URL backend thật, không đưa AI_SERVICE_TOKEN vào frontend.
# [VITE_API_URL] Phải trỏ cùng backend với Creator để dùng chung cookie/session; local dùng localhost cho cả hai ứng dụng.
VITE_API_URL=http://localhost:3001/api
