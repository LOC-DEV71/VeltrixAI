# [VITE_API_URL] URL gốc API mà client gọi, thường http://localhost:3001/api; khi deploy dùng URL backend thật.
# [VITE_API_URL] Axios tự ghép các đường dẫn như /v1/auth và /users: tránh thêm /v1 vào URL gốc. Biến VITE_ được chụp lúc build và công khai trong trình duyệt.
# [VITE_API_URL] Mẫu code API trên landing và tài liệu tự ghép /developer/v1 vào URL này; khác VITE_DEVELOPER_URL là địa chỉ trang web Developer.
VITE_API_URL=http://localhost:3001/api

# [VITE_APP_URL] URL ứng dụng client; local dùng cổng 5173, production dùng domain client thật.
# [VITE_APP_URL] Dùng cho URL SEO/dữ liệu cấu trúc; không đặt cổng Vite. Đổi biến cần build/redeploy lại.
VITE_APP_URL=http://localhost:5173

# [VITE_DEVELOPER_URL] URL đầy đủ trang/ứng dụng Developer, gồm đường dẫn nếu có; local là http://localhost:5173/developer.
# [VITE_DEVELOPER_URL] Landing dùng biến này cho Khám phá API và link footer; trang Developer dùng cho URL SEO. Khi deploy đổi thành URL Developer thật rồi rebuild/redeploy.
# [VITE_DEVELOPER_URL] Để trống sẽ dùng đường dẫn /developer trên VITE_APP_URL hoặc origin client hiện tại.
VITE_DEVELOPER_URL=http://localhost:5173/developer

# [VITE_GOOGLE_CLIENT_ID] Client ID OAuth Google công khai cho nút đăng nhập; khớp GOOGLE_CLIENT_ID ở backend.
# [VITE_GOOGLE_CLIENT_ID] Điền Client ID của dự án Google Cloud; không điền client secret vào biến VITE_.
VITE_GOOGLE_CLIENT_ID=

# Support là ứng dụng riêng; đổi URL sang domain Support khi deploy.
# [VITE_SUPPORT_URL] URL ứng dụng Support riêng: local http://localhost:5175; khi deploy đổi sang domain Support thật.
# [VITE_SUPPORT_URL] Dùng chung cho cảnh báo Free theo IP, Trung tâm hỗ trợ, Docs và chính sách; để trống sẽ ẩn link hỗ trợ. Đổi biến phải restart Vite hoặc rebuild/redeploy.
# [VITE_SUPPORT_URL] Cũng là domain/đường dẫn được phép quay lại sau đăng nhập Creator khi mở Support; phải khớp URL ứng dụng Support thật.
VITE_SUPPORT_URL=http://localhost:5175
