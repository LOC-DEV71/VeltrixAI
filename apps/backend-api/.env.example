# [MONGODB_URI] Chuỗi kết nối MongoDB của backend, gồm máy chủ, tên database và thông tin xác thực nếu có.
# [MONGODB_URI] Database phải hỗ trợ transaction (Atlas hoặc replica set) cho thanh toán, Credit và giới hạn Free theo IP.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/creatorai
# [REDIS_URI] Địa chỉ Redis của hệ thống, ví dụ redis://localhost:6379; khi deploy điền Redis nội bộ tương ứng.
# [REDIS_URI] Backend hiện còn kiểm tra biến này trong readiness production; luồng job MongoDB không tự đổi sang Redis khi điền biến.
REDIS_URI=redis://localhost:6379
# [PORT] Cổng HTTP backend lắng nghe; mặc định là 3001. Client/Admin phải kết nối hoặc proxy về cổng này.
PORT=3001

# Xác thực và phiên đăng nhập
# [JWT_SECRET] Khóa bí mật để ký và kiểm tra access token của client/admin; chỉ đặt ở server.
# [JWT_SECRET] Production cần ít nhất 32 ký tự. Đổi khóa làm token đã ký không còn hợp lệ.
JWT_SECRET=super-secret-jwt-key
# [OTP_SECRET] Khóa bí mật HMAC để băm mã OTP trước khi lưu; chỉ đặt ở backend, không đưa lên client.
# [OTP_SECRET] Các instance backend phải dùng cùng khóa để xác minh OTP; đổi khóa khiến OTP đang chờ không còn hợp lệ.
OTP_SECRET=super-secret-otp-key

# Đăng nhập Google OAuth
# [GOOGLE_CLIENT_ID] Client ID OAuth của ứng dụng Google để backend xác minh ID token đúng ứng dụng.
# [GOOGLE_CLIENT_ID] Dùng cùng ứng dụng OAuth với VITE_GOOGLE_CLIENT_ID; cấu hình origin/redirect hợp lệ trên Google Cloud khi deploy.
GOOGLE_CLIENT_ID=763879280271-nvuif23lgm05jhdpetnnoa4m0rvih453.apps.googleusercontent.com

# Nhà cung cấp email OTP (Resend)
# [RESEND_API_KEY] Khóa API riêng của Resend, dự kiến dùng gửi email OTP từ backend; không đưa vào biến VITE_.
# [RESEND_API_KEY] Luồng requestOtp hiện mới kiểm tra cấu hình, bước gửi email thật còn cần hoàn thiện; chỉ điền khóa chưa bảo đảm email được gửi.
# RESEND_API_KEY=re_your_api_key

# CORS và IP thật phía sau proxy
# [CORS_ORIGINS] Danh sách origin được gọi backend bằng trình duyệt/cookie, cách nhau bởi dấu phẩy; không kèm đường dẫn.
# [CORS_ORIGINS] Local thường gồm http://localhost:5173,http://localhost:5174; khi deploy điền origin Client, Admin và Support nếu Support gọi API.
CORS_ORIGINS=http://localhost:5173
# [TRUST_PROXY] Cách Express tin cậy proxy để xác định IP thật: false khi truy cập trực tiếp; hoặc danh sách IPv4 proxy tin cậy, cách nhau bằng dấu phẩy.
# [TRUST_PROXY] true tin toàn bộ chuỗi proxy: chỉ dùng khi đường vào backend được kiểm soát. IP này dùng cho giới hạn 3 tài khoản Free/IP/tháng.
TRUST_PROXY=false

# Dịch vụ AI viết nội dung
# [GEMINI_API_KEY] Khóa API Google Gemini cho viết nội dung AI khi AI_PROVIDER=gemini; chỉ đặt ở backend.
# [GEMINI_API_KEY] Không bắt buộc cho provider local; chọn local không tự chuyển sang Gemini khi dịch vụ local lỗi.
GEMINI_API_KEY=
# Chọn local thì không tự chuyển sang Gemini khi lỗi.
# [AI_PROVIDER] Chọn dịch vụ viết nội dung: local (Gemma tự chạy) hoặc gemini (Google). Nếu không đặt, code mặc định gemini.
# [AI_PROVIDER] Đổi biến cần khởi động lại backend/worker; không phải tên gói Free/Plus/Pro.
AI_PROVIDER=gemini
# Có thể ghi đè kết nối AI local; nếu không, dùng tệp connection.json riêng trên máy.
# [AI_SERVICE_URL] URL gốc của dịch vụ AI local tương thích chat completion; code hiện chấp nhận HTTP loopback trên cùng máy backend.
# [AI_SERVICE_URL] Không thêm đường dẫn API. Nếu cả URL và token đều trống, code đọc services/ai/.runtime/connection.json.
AI_SERVICE_URL=
# [AI_SERVICE_TOKEN] Token bí mật xác thực giữa backend và dịch vụ AI local; cần ít nhất 32 ký tự và khớp token phía dịch vụ.
# [AI_SERVICE_TOKEN] Nếu cấu hình AI_SERVICE_URL thủ công thì phải điền token tương ứng; không đưa vào biến VITE_.
AI_SERVICE_TOKEN=
# [AI_MODEL] Tên model mà dịch vụ AI local công bố; phải khớp ID model tại dịch vụ, không phải đường dẫn tệp GGUF.
# [AI_MODEL] Nếu không ghi đè, dùng model từ connection.json hoặc mặc định veltrix-gemma-e4b.
AI_MODEL=
# [AI_CONTEXT_TOKENS] Dung lượng context của AI local, tính theo token; code hỗ trợ 4096, 8192 hoặc 16384.
# [AI_CONTEXT_TOKENS] Gồm nội dung đầu vào và đầu ra trong ngữ cảnh; không phải số Credit. Cần phù hợp context của dịch vụ model.
AI_CONTEXT_TOKENS=8192
# [AI_MAX_OUTPUT_TOKENS] Số token đầu ra tối đa cho AI local; số nguyên từ 128 đến một nửa AI_CONTEXT_TOKENS.
# [AI_MAX_OUTPUT_TOKENS] Giới hạn token không tương đương số giây video hay số ký tự; ảnh hưởng độ dài phản hồi model.
AI_MAX_OUTPUT_TOKENS=4096
# [AI_IMAGE_MAX_TOKENS] Ngân sách thị giác cố định (min=max) của Gemma khi chạy services/ai/start.cjs; giá trị 70, 140, 280, 560 hoặc 1120.
# [AI_IMAGE_MAX_TOKENS] Mặc định 1120 để đọc screenshot/code rõ hơn; mức cao tốn thêm RAM và thời gian xử lý ảnh.
# [AI_IMAGE_MAX_TOKENS] Đặt biến cho tiến trình khởi động dịch vụ AI rồi chạy lại dịch vụ; chỉ đổi env backend không cập nhật model đã chạy.
AI_IMAGE_MAX_TOKENS=1120

# Kho media Cloudinary
# [CLOUDINARY_CLOUD_NAME] Tên cloud của tài khoản Cloudinary để lưu/phục vụ media như ảnh đại diện và audio theo cấu hình dự án.
CLOUDINARY_CLOUD_NAME=
# [CLOUDINARY_API_KEY] API key Cloudinary cho backend ký yêu cầu/upload media; phải thuộc cùng cloud với CLOUDINARY_CLOUD_NAME.
CLOUDINARY_API_KEY=
# [CLOUDINARY_API_SECRET] API secret Cloudinary dùng ký upload và truy cập media riêng tư; chỉ giữ trên backend, không đưa lên client.
CLOUDINARY_API_SECRET=

# Dịch vụ nội bộ
# [INTERNAL_TTS_API_URL] Biến TTS cũ đang còn trong cấu hình; provider TTS hiện tại không đọc biến này.
# [INTERNAL_TTS_API_URL] Địa chỉ dịch vụ đang dùng phải cấu hình bằng TTS_SERVICE_URL và TTS_SERVICE_TOKEN hoặc connection.json local.
INTERNAL_TTS_API_URL=http://localhost:8000

# TTS nội bộ: token dùng chung với Python, chỉ giữ ở server.
# [TTS_SERVICE_URL] URL gốc dịch vụ TTS nội bộ tự chạy, dùng cho tạo lời đọc và xử lý mẫu clone; không thêm đường dẫn API.
# [TTS_SERVICE_URL] Chấp nhận host/IP nội bộ. Local có thể đọc connection.json nếu URL và token đều trống; production phải cấu hình rõ.
TTS_SERVICE_URL=http://127.0.0.1:8001
# [TTS_SERVICE_TOKEN] Token bí mật chung giữa Python TTS và backend/worker; tối thiểu 32 ký tự ASCII không có khoảng trắng.
# [TTS_SERVICE_TOKEN] Phải giống nhau ở hai phía. Không phải token Developer cấp cho khách tích hợp, không đưa vào biến VITE_.
TTS_SERVICE_TOKEN=

# VNPay: các khóa bí mật chỉ đặt ở backend.
# [VNPAY_MODE] Môi trường VNPay: sandbox để thử nghiệm hoặc production để thu tiền thật.
# [VNPAY_MODE] TmnCode, HashSecret và URL callback phải đúng môi trường; đổi mode không tự chuyển tài khoản thử nghiệm thành merchant thật.
VNPAY_MODE=sandbox
# [VNPAY_TMN_CODE] Mã terminal/merchant của cổng thanh toán VNPay, do VNPay cung cấp cho môi trường đang chọn.
VNPAY_TMN_CODE=
# [VNPAY_HASH_SECRET] Khóa bí mật VNPay dùng ký yêu cầu và kiểm tra chữ ký callback/IPN; chỉ đặt ở backend.
# [VNPAY_HASH_SECRET] Sai khóa sẽ không xác nhận được thanh toán; không đưa vào biến VITE_.
VNPAY_HASH_SECRET=
# [VNPAY_RETURN_URL] URL HTTPS callback backend nhận khi người dùng quay về từ VNPay.
# [VNPAY_RETURN_URL] Phải trỏ đúng route Return của backend và khớp cấu hình merchant; không điền URL trang client vào đây.
VNPAY_RETURN_URL=
# [VNPAY_CLIENT_URL] URL ứng dụng client để backend đưa người dùng về màn hình kết quả thanh toán sau xử lý Return.
# [VNPAY_CLIENT_URL] Local trỏ client 5173; khi deploy dùng domain client thật.
VNPAY_CLIENT_URL=http://localhost:5173
# [VNPAY_REFUND_ENABLED] true để bật kiểm tra/hoàn tiền gia hạn sau khi merchant được VNPay cấp quyền API querydr/refund.
# [VNPAY_REFUND_ENABLED] Chỉ backend gửi tiền sau khi khách xác nhận và đối chiếu đủ; mặc định false để chưa cấu hình không phát lệnh.
VNPAY_REFUND_ENABLED=false
# [VNPAY_SERVER_IP] IP public của máy chủ gọi API VNPay; không phải IP trình duyệt khách. Có thể IPv4/IPv6, phải được merchant cho phép.
VNPAY_SERVER_IP=
# [VNPAY_TRANSACTION_API_URL] URL HTTPS API querydr/refund production do VNPay cấp, thuộc domain VNPay được cho phép.
# [VNPAY_TRANSACTION_API_URL] Sandbox dùng endpoint chính thức có sẵn; production không tự đoán URL.
VNPAY_TRANSACTION_API_URL=
# Lưu thẻ Visa chỉ bật khi merchant được VNPay cấp quyền; khóa AES-256 gồm 64 ký tự hex.
# [VNPAY_TOKEN_ENABLED] true để bật lưu thẻ/thanh toán bằng token VNPay; false để tắt.
# [VNPAY_TOKEN_ENABLED] Chỉ hoạt động khi merchant được VNPay cấp quyền tokenization và các biến VNPAY_TOKEN_* đầy đủ.
VNPAY_TOKEN_ENABLED=false
# [VNPAY_TOKEN_TMN_CODE] Mã terminal riêng cho dịch vụ tokenization/lưu thẻ VNPay do merchant được cấp; không tự mặc định bằng mã thanh toán thường.
VNPAY_TOKEN_TMN_CODE=
# [VNPAY_TOKEN_HASH_SECRET] Khóa ký/kiểm tra callback của dịch vụ tokenization VNPay; phải khớp VNPAY_TOKEN_TMN_CODE, chỉ đặt ở backend.
VNPAY_TOKEN_HASH_SECRET=
# [VNPAY_TOKEN_ENCRYPTION_KEY] Khóa AES-256 để mã hóa token thẻ lưu trong database: đúng 64 ký tự hexadecimal (32 byte).
# [VNPAY_TOKEN_ENCRYPTION_KEY] Giữ ổn định khi deploy; đổi khóa sẽ khiến token đã mã hóa bằng khóa cũ không đọc được.
VNPAY_TOKEN_ENCRYPTION_KEY=
# [VNPAY_TOKEN_RETURN_URL] URL HTTPS callback backend cho luồng tạo/lưu token thẻ, khác luồng Return thanh toán thông thường.
# [VNPAY_TOKEN_RETURN_URL] Trỏ đúng route token Return của backend và đăng ký URL này với VNPay.
VNPAY_TOKEN_RETURN_URL=
# Endpoint token production do VNPay cung cấp; sandbox dùng endpoint thử nghiệm.
# [VNPAY_TOKEN_CREATE_URL] Endpoint HTTPS tạo token thẻ do VNPay cấp cho production; code sandbox dùng endpoint thử nghiệm sẵn có.
# [VNPAY_TOKEN_CREATE_URL] URL production phải thuộc host VNPay được code cho phép, không phải domain client/backend của bạn.
VNPAY_TOKEN_CREATE_URL=
# [VNPAY_TOKEN_PAYMENT_URL] Endpoint HTTPS thanh toán bằng token thẻ do VNPay cấp cho production; sandbox dùng endpoint thử nghiệm sẵn có.
# [VNPAY_TOKEN_PAYMENT_URL] Không phải URL Return hoặc IPN; chỉ cấu hình khi dịch vụ tokenization đã được merchant bật.
VNPAY_TOKEN_PAYMENT_URL=
# [SUPPORT_ORIGINS] Danh sách origin được gọi session/refresh/logout/chat Support bằng cookie Creator, cách nhau bằng dấu phẩy; không kèm đường dẫn.
# [SUPPORT_ORIGINS] Production phải điền domain Support thật. Local tự cho phép localhost:5175 và 127.0.0.1:5175. Chat chỉ dùng services/ai local, không tự gọi Gemini.
SUPPORT_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# ===== Video tự động (pipeline chủ đề -> video) =====
# [IDEA_SUGGESTIONS_DAILY_LIMIT] Số lượt gợi ý ý tưởng miễn phí mỗi người mỗi ngày (UTC). Mặc định 20. Lượt lỗi không bị tính.
IDEA_SUGGESTIONS_DAILY_LIMIT=20
# [VIDEO_RENDER_CREDITS] Credit cho mỗi lần dựng video (không gồm phí viết kịch bản và TTS). Mặc định 50. Hoàn lại khi dựng lỗi.
VIDEO_RENDER_CREDITS=50
# [VIDEO_STORAGE_DIR] Thư mục lưu file mp4 đã dựng. Mặc định apps/backend-api/.runtime/videos. Worker video và API phải cùng đọc được thư mục này.
VIDEO_STORAGE_DIR=
# [VIDEO_RENDERER_DIR] Đường dẫn package packages/video-renderer (Remotion). Mặc định tự tìm trong monorepo.
VIDEO_RENDERER_DIR=
# [PEXELS_API_KEY] Key Pexels để lấy ảnh minh họa theo từ khóa từng cảnh. Bỏ trống thì dùng nền gradient. Lấy key tại https://www.pexels.com/api/
PEXELS_API_KEY=

# ===== Đăng YouTube =====
# [YOUTUBE_CLIENT_ID]/[YOUTUBE_CLIENT_SECRET] OAuth client loại "Web application" trên Google Cloud Console, đã bật YouTube Data API v3.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# [YOUTUBE_REDIRECT_URI] Phải trùng "Authorized redirect URI" trên Google Cloud. Local: http://localhost:3001/api/youtube/callback
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/youtube/callback
# [YOUTUBE_TOKEN_ENCRYPTION_KEY] 64 ký tự hex (32 byte) để mã hóa refresh token. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# [YOUTUBE_TOKEN_ENCRYPTION_KEY] Đổi key sẽ làm các kết nối cũ không dùng được; người dùng phải kết nối lại.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
# [YOUTUBE_CLIENT_URL] URL web-client để đưa người dùng về sau khi kết nối. Mặc định dùng VNPAY_CLIENT_URL.
YOUTUBE_CLIENT_URL=http://localhost:5173
# [YOUTUBE_DAILY_UPLOADS] Số video tối đa mỗi người được đăng YouTube mỗi ngày (UTC). Mặc định 3. Dự án Google chưa xác minh chỉ đăng được video riêng tư.
YOUTUBE_DAILY_UPLOADS=3

# AI scene images (packages/image-gen). Cloud preset appears only when a fal.ai key is set.
FAL_KEY=
# FAL_AI_API_KEY= (alias, either one is read)
# Hugging Face token, only needed for gated models (the default presets are not gated).
HF_TOKEN=
# Optional: where model weights are cached (default: ~/.cache/huggingface).
# HF_HOME=
# Optional overrides: IMAGE_GEN_DIR, IMAGE_GEN_CACHE_DIR
