# VNPay: configure locally; never expose these variables through VITE_.
VNPAY_MODE=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_CLIENT_URL=http://localhost:5173
